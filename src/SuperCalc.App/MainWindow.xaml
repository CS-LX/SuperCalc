<Window x:Class="SuperCalc.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SuperCalc">
 <Window.SystemBackdrop><MicaBackdrop/></Window.SystemBackdrop>
 <Grid x:Name="Root" Background="Transparent" KeyDown="Root_KeyDown">
  <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Margin="16,0,140,0">
   <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
    <FontIcon Glyph="&#xE8EF;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
    <TextBlock Text="SuperCalc" FontSize="12" VerticalAlignment="Center"/>
   </StackPanel>
  </Grid>
  <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="LeftCompact" IsPaneOpen="False" OpenPaneLength="240" CompactPaneLength="48" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" IsTitleBarAutoPaddingEnabled="False" ItemInvoked="Navigation_ItemInvoked">
   <NavigationView.MenuItems>
    <NavigationViewItem x:Name="CalcNav" Content="标准" Tag="calc" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8EF;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem x:Name="HistoryNav" Content="历史记录" Tag="history"><NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItemSeparator/>
    <NavigationViewItem Content="OneNumber" Tag="cloud"><NavigationViewItem.Icon><FontIcon Glyph="&#xE753;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="SuperCalc 365" Tag="premium"><NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" Foreground="{ThemeResource PromoAccentBrush}"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem x:Name="MuseumNav" Content="新增功能" Tag="museum"><NavigationViewItem.Icon><FontIcon Glyph="&#xE946;"/></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.MenuItems>
   <NavigationView.FooterMenuItems>
    <NavigationViewItem Content="个人资料" Tag="account"><NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;"/></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.FooterMenuItems>
   <Grid x:Name="Workspace" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8,0,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="16,0,12,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="PageTitle" Text="标准" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <ToggleSwitch x:Name="FocusToggle" OffContent="专注" OnContent="专注" MinWidth="108" Toggled="Focus_Toggled" AutomationProperties.Name="专注模式"/>
      <Button Click="Copy_Click" Style="{StaticResource MemoryKey}" ToolTipService.ToolTip="复制结果" AutomationProperties.Name="复制结果"><FontIcon Glyph="&#xE8C8;" FontSize="16"/></Button>
      <Button Click="Panel_Click" Style="{StaticResource MemoryKey}" ToolTipService.ToolTip="CalcPilot" AutomationProperties.Name="打开 CalcPilot"><FontIcon Glyph="&#xE945;" FontSize="16" Foreground="{ThemeResource PromoAccentBrush}"/></Button>
      <Button Content="&#xE712;" FontFamily="Segoe Fluent Icons" Click="More_Click" Style="{StaticResource MemoryKey}" AutomationProperties.Name="更多选项" ToolTipService.ToolTip="更多选项"/>
     </StackPanel>
    </Grid>
    <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Informational" Margin="12,0,12,4"/>
    <Grid x:Name="CalculatorPage" Grid.Row="2">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="AssistantColumn" Width="300"/></Grid.ColumnDefinitions>
     <Grid x:Name="CalculationSurface" Margin="8,0,8,8">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <InfoBar x:Name="WelcomeBanner" IsOpen="True" IsClosable="True" Severity="Informational" Message="获取完整的 SuperCalc 体验" Margin="4,0,4,6">
       <InfoBar.ActionButton><Button Content="完成设置" Click="Onboarding_Click" Padding="8,3"/></InfoBar.ActionButton>
      </InfoBar>
      <Grid Grid.Row="1">
       <Grid.RowDefinitions><RowDefinition x:Name="DisplayRow" Height="150"/><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Grid Padding="12,4,12,4">
        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
        <TextBox x:Name="ExpressionBox" PlaceholderText="输入算式" TextAlignment="Right" FontSize="16" BorderThickness="0" Background="Transparent" MaxLength="512" KeyDown="Expression_KeyDown" TextChanged="Expression_Changed" AutomationProperties.Name="算式输入"/>
        <TextBlock x:Name="ResultText" Grid.Row="1" Text="0" FontSize="56" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite"/>
        <Grid Grid.Row="2"><TextBlock x:Name="ResultCaption" Text="就绪" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/><TextBlock x:Name="MemoryLabel" Text="M · 空" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
       </Grid>
       <Grid Grid.Row="1" ColumnSpacing="3">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Button Content="MC" Click="Memory_Click" Tag="clear" Style="{StaticResource MemoryKey}" ToolTipService.ToolTip="清除记忆"/>
        <Button Grid.Column="1" Content="MR" Click="Memory_Click" Tag="recall" Style="{StaticResource MemoryKey}" ToolTipService.ToolTip="读取记忆"/>
        <Button Grid.Column="2" Content="M+" Click="Memory_Click" Tag="add" Style="{StaticResource MemoryKey}" ToolTipService.ToolTip="记忆加"/>
        <Button Grid.Column="3" Content="M−" Click="Memory_Click" Tag="subtract" Style="{StaticResource MemoryKey}" ToolTipService.ToolTip="记忆减"/>
        <Button Grid.Column="4" Content="(" Tag="(" Click="Key_Click" Style="{StaticResource MemoryKey}"/>
        <Button Grid.Column="5" Content=")" Tag=")" Click="Key_Click" Style="{StaticResource MemoryKey}"/>
       </Grid>
       <Grid x:Name="Keypad" Grid.Row="2" ColumnSpacing="3" RowSpacing="3">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <Button Content="%" Style="{StaticResource OperatorKey}" Click="Key_Click" Tag="%" ToolTipService.ToolTip="百分数：50% = 0.5"/><Button Grid.Column="1" Content="CE" Style="{StaticResource OperatorKey}" Click="ClearEntry_Click" ToolTipService.ToolTip="清除末尾数字"/><Button Grid.Column="2" Content="C" Style="{StaticResource OperatorKey}" Click="Clear_Click"/><Button Grid.Column="3" Content="⌫" Style="{StaticResource OperatorKey}" Click="Backspace_Click" AutomationProperties.Name="退格"/>
          <Button Grid.Row="1" Content="1/x" Style="{StaticResource OperatorKey}" Click="Unary_Click" Tag="reciprocal"/><Button Grid.Row="1" Grid.Column="1" Content="x²" Style="{StaticResource OperatorKey}" Click="Unary_Click" Tag="square"/><Button Grid.Row="1" Grid.Column="2" Content="√x" Style="{StaticResource OperatorKey}" Click="Unary_Click" Tag="sqrt"/><Button Grid.Row="1" Grid.Column="3" Content="÷" Style="{StaticResource OperatorKey}" Click="Key_Click" Tag="÷"/>
          <Button Grid.Row="2" Content="7" Style="{StaticResource Key}" Click="Key_Click" Tag="7"/><Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource Key}" Click="Key_Click" Tag="8"/><Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource Key}" Click="Key_Click" Tag="9"/><Button Grid.Row="2" Grid.Column="3" Content="×" Style="{StaticResource OperatorKey}" Click="Key_Click" Tag="×"/>
          <Button Grid.Row="3" Content="4" Style="{StaticResource Key}" Click="Key_Click" Tag="4"/><Button Grid.Row="3" Grid.Column="1" Content="5" Style="{StaticResource Key}" Click="Key_Click" Tag="5"/><Button Grid.Row="3" Grid.Column="2" Content="6" Style="{StaticResource Key}" Click="Key_Click" Tag="6"/><Button Grid.Row="3" Grid.Column="3" Content="−" Style="{StaticResource OperatorKey}" Click="Key_Click" Tag="−"/>
          <Button Grid.Row="4" Content="1" Style="{StaticResource Key}" Click="Key_Click" Tag="1"/><Button Grid.Row="4" Grid.Column="1" Content="2" Style="{StaticResource Key}" Click="Key_Click" Tag="2"/><Button Grid.Row="4" Grid.Column="2" Content="3" Style="{StaticResource Key}" Click="Key_Click" Tag="3"/><Button Grid.Row="4" Grid.Column="3" Content="+" Style="{StaticResource OperatorKey}" Click="Key_Click" Tag="+"/>
          <Button Grid.Row="5" Content="+/−" Style="{StaticResource Key}" Click="Unary_Click" Tag="negate"/><Button Grid.Row="5" Grid.Column="1" Content="0" Style="{StaticResource Key}" Click="Key_Click" Tag="0"/><Button Grid.Row="5" Grid.Column="2" Content="." Style="{StaticResource Key}" Click="Key_Click" Tag="."/><Button x:Name="EqualsButton" Grid.Row="5" Grid.Column="3" Content="=" Style="{StaticResource Key}" Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Click="Equals_Click" AutomationProperties.Name="计算结果"/>
         </Grid>
      </Grid>
      <Border x:Name="RecommendationCard" Grid.Row="2" Background="{ThemeResource PromoSurfaceBrush}" BorderBrush="{ThemeResource PromoBorderBrush}" BorderThickness="0,1,0,0" Padding="10,8,8,8" Margin="0,8,0,0" CornerRadius="4">
       <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="2"><TextBlock Text="推荐" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="RecommendationText" Text="使用 SuperCalc 365，发现更多计算可能。" TextTrimming="CharacterEllipsis" FontSize="12"/></StackPanel>
        <Button Grid.Column="1" Content="了解更多" Click="Premium_Click" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource PromoTextBrush}"/>
       </Grid>
      </Border>
     </Grid>
     <Border x:Name="AssistantPanel" Grid.Column="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
      <Pivot x:Name="SideTabs" SelectionChanged="SideTabs_SelectionChanged">
       <PivotItem Header="CalcPilot">
        <Grid Margin="0,4,0,12">
         <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="18" Padding="4,12,4,12">
           <StackPanel Orientation="Horizontal" Spacing="10"><Border Width="40" Height="40" CornerRadius="10" Background="{ThemeResource PromoSurfaceBrush}" BorderBrush="{ThemeResource PromoBorderBrush}" BorderThickness="1"><FontIcon Glyph="&#xE945;" Foreground="{ThemeResource PromoAccentBrush}" FontSize="24"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="CalcPilot" FontWeight="SemiBold"/><TextBlock Text="你的日常计算助手" Style="{StaticResource SmallLabel}" TextWrapping="Wrap"/></StackPanel></StackPanel>
           <TextBlock Text="我可以帮助你做什么？" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
           <Button Content="解释当前结果" Click="Pilot_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
           <Button Content="为我推荐一个算式" Click="Recommendation_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
           <Border Background="{ThemeResource PromoSurfaceBrush}" BorderBrush="{ThemeResource PromoBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel Spacing="10"><TextBlock x:Name="PilotReply" Text="选择一个建议，或计算一个结果以开始。" TextWrapping="Wrap" FontSize="13" LineHeight="21"/><ProgressBar x:Name="ThinkingBar" Foreground="{ThemeResource PromoAccentBrush}" IsIndeterminate="True" Visibility="Collapsed"/></StackPanel>
           </Border>
           <Expander Header="个性化" IsExpanded="False" HorizontalAlignment="Stretch"><ComboBox x:Name="ToneBox" Header="回答方式" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem Content="专业"/><ComboBoxItem Content="鼓舞人心"/><ComboBoxItem Content="商务"/></ComboBox></Expander>
           <Grid><TextBlock Text="体验健康度" FontSize="12"/><TextBlock x:Name="HealthScore" Text="42 / 100" HorizontalAlignment="Right" FontSize="12"/></Grid>
           <ProgressBar x:Name="HealthProgress" Value="42"/>
           <TextBlock x:Name="HealthText" Text="完成推荐设置，充分利用 SuperCalc。" TextWrapping="Wrap" Style="{StaticResource SmallLabel}"/>
           <HyperlinkButton Content="查看建议" Click="Optimize_Click" Padding="0"/>
          </StackPanel>
         </ScrollViewer>
         <Border Grid.Row="1" Background="{ThemeResource PromoBorderBrush}" Padding="1" CornerRadius="5" Margin="4,10,4,0"><Button Content="询问 CalcPilot" Click="Pilot_Click" Background="{ThemeResource PromoSurfaceBrush}" Foreground="{ThemeResource PromoTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Stretch"/></Border>
        </Grid>
       </PivotItem>
       <PivotItem Header="历史记录">
        <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer><StackPanel x:Name="RecentItems" Spacing="4"/></ScrollViewer><Button Grid.Row="1" Content="查看所有历史记录" Click="History_Click" HorizontalAlignment="Stretch" Margin="0,10,0,12"/></Grid>
       </PivotItem>
      </Pivot>
     </Border>
    </Grid>
    <ScrollViewer x:Name="HistoryPage" Grid.Row="2" Visibility="Collapsed">
     <StackPanel Margin="24,8,24,24" Spacing="12">
      <AutoSuggestBox x:Name="HistorySearch" PlaceholderText="搜索历史记录" QueryIcon="Find" TextChanged="Search_Changed"/>
      <InfoBar x:Name="SearchPromotion" IsOpen="True" IsClosable="False" Severity="Informational" Title="推荐" Message="通过 SuperCalc 365 获取更多工作流建议。"/>
      <Grid><TextBlock Text="最近的计算" Style="{StaticResource SmallLabel}" VerticalAlignment="Center"/><Button Content="清空历史记录" Click="ClearHistory_Click" HorizontalAlignment="Right"/></Grid>
      <StackPanel x:Name="HistoryItems" Spacing="4"/>
     </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="SettingsPage" Grid.Row="2" Visibility="Collapsed">
     <StackPanel Margin="24,8,24,24" Spacing="8">
      <Border Style="{StaticResource Card}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><PersonPicture Width="48" Height="48" Initials="SC"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="AccountLabel" Text="个人资料" FontWeight="SemiBold"/><TextBlock Text="管理你的账户与偏好" Style="{StaticResource SmallLabel}" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="2" Content="管理" Click="Account_Click" VerticalAlignment="Center"/></Grid></Border>
      <TextBlock Text="个性化" FontWeight="SemiBold" Margin="0,16,0,4"/>
      <Border Style="{StaticResource Card}"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="增强计算体验"/><TextBlock Text="结果建议和智能工作流" Style="{StaticResource SmallLabel}" TextWrapping="Wrap"/></StackPanel><ToggleSwitch Grid.Column="1" x:Name="DramaToggle" HorizontalAlignment="Right" OnContent="开" OffContent="关" Toggled="Settings_Toggled" AutomationProperties.Name="增强计算体验"/></Grid></Border>
      <Border Style="{StaticResource Card}"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="动画效果"/><TextBlock Text="在控件和页面之间显示平滑过渡" Style="{StaticResource SmallLabel}" TextWrapping="Wrap"/></StackPanel><ToggleSwitch Grid.Column="1" x:Name="AnimationToggle" HorizontalAlignment="Right" OnContent="开" OffContent="关" Toggled="Settings_Toggled" AutomationProperties.Name="动画效果"/></Grid></Border>
      <Border Style="{StaticResource Card}"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="建议与优惠"/><TextBlock Text="根据使用情况提供个性化推荐" Style="{StaticResource SmallLabel}" TextWrapping="Wrap"/></StackPanel><ToggleSwitch Grid.Column="1" x:Name="RecommendationsToggle" HorizontalAlignment="Right" OnContent="开" OffContent="关" Toggled="Settings_Toggled" AutomationProperties.Name="建议与优惠"/></Grid></Border>
      <Border Style="{StaticResource Card}"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="帮助改进 SuperCalc"/><TextBlock Text="离开时提供反馈建议" Style="{StaticResource SmallLabel}" TextWrapping="Wrap"/></StackPanel><ToggleSwitch Grid.Column="1" x:Name="ExitToggle" HorizontalAlignment="Right" OnContent="开" OffContent="关" Toggled="Settings_Toggled" AutomationProperties.Name="离开时提供反馈"/></Grid></Border>
      <TextBlock Text="相关设置" FontWeight="SemiBold" Margin="0,16,0,4"/>
      <Expander Header="高级计算设置" HorizontalAlignment="Stretch"><StackPanel Spacing="10"><Button Content="结果的默认打开方式" Click="ChooseResult_Click"/><Button Content="其他数字属性" Click="Legacy_Click"/></StackPanel></Expander>
      <Expander Header="应用更新" HorizontalAlignment="Stretch"><StackPanel Spacing="10"><TextBlock Text="SuperCalc  1.1.0"/><Button Content="检查更新" Click="Update_Click"/></StackPanel></Expander>
      <Button Content="完成设备设置" Click="Onboarding_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
     </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="MuseumPage" Grid.Row="2" Visibility="Collapsed">
     <StackPanel Margin="24,8,24,24" Spacing="12"><TextBlock Text="充分利用 SuperCalc" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="发现为你准备的新功能和更便捷的工作方式。" Style="{StaticResource SmallLabel}" TextWrapping="Wrap"/><StackPanel x:Name="MuseumItems" Spacing="8"/></StackPanel>
    </ScrollViewer>
   </Grid>
  </NavigationView>
  <Grid Grid.Row="2" Padding="12,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="StatusText" Text="就绪" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   <TextBlock x:Name="SessionStats" Grid.Column="1" Text="标准" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
  </Grid>
 </Grid>
</Window>
