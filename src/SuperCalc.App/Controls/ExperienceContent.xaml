<UserControl x:Class="SuperCalc.App.Controls.ExperienceContent" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel x:Name="Surface" Spacing="16" MaxWidth="520">
  <Border Background="{ThemeResource PromoSurfaceBrush}" BorderBrush="{ThemeResource PromoBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
   <Grid ColumnSpacing="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid Width="56" Height="64" VerticalAlignment="Center"><FontIcon x:Name="HeroIcon" Glyph="&#xE8EF;" FontSize="40" Foreground="{ThemeResource PromoAccentBrush}"/><Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom"><FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource PromoTextBrush}"/></Border></Grid>
    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center"><TextBlock x:Name="Eyebrow" Text="SUPERCALC" FontSize="11" CharacterSpacing="100" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="Description" FontSize="13" TextWrapping="Wrap"/></StackPanel>
   </Grid>
  </Border>
  <StackPanel x:Name="Items" Spacing="8"/>
  <TextBlock x:Name="Footnote" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
 </StackPanel>
</UserControl>
