<UserControl x:Class="SuperCalc.App.Controls.SetupWizard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Spacing="16" MaxWidth="520">
  <Grid ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel Spacing="7"><TextBlock x:Name="StepLabel0" Text="1  欢迎使用" FontSize="12"/><ProgressBar x:Name="StepBar0" Value="100"/></StackPanel>
   <StackPanel Grid.Column="1" Spacing="7"><TextBlock x:Name="StepLabel1" Text="2  个人资料" FontSize="12"/><ProgressBar x:Name="StepBar1" Value="0"/></StackPanel>
   <StackPanel Grid.Column="2" Spacing="7"><TextBlock x:Name="StepLabel2" Text="3  推荐设置" FontSize="12"/><ProgressBar x:Name="StepBar2" Value="0"/></StackPanel>
  </Grid>
  <Grid x:Name="PageSurface">
   <StackPanel x:Name="WelcomePage" Spacing="14">
    <Border Background="{ThemeResource PromoSurfaceBrush}" BorderBrush="{ThemeResource PromoBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24,20">
     <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Width="88" Height="90"><FontIcon Glyph="&#xE7F4;" FontSize="64" Foreground="{ThemeResource PromoAccentBrush}"/><Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Width="36" Height="36" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"><FontIcon Glyph="&#xE753;" FontSize="22" Foreground="{ThemeResource PromoTextBrush}"/></Border></Grid>
      <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center"><TextBlock Text="为你的下一步做好准备" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="只需几个步骤，即可充分利用 SuperCalc。" TextWrapping="Wrap" FontSize="13"/></StackPanel>
     </Grid>
    </Border>
    <Border Style="{StaticResource Card}"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE753;" Foreground="{ThemeResource PromoTextBrush}"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="将你的数字集中在一处" FontWeight="SemiBold"/><TextBlock Text="通过 OneNumber 整理最近的计算与工作空间。" Style="{StaticResource SmallLabel}" TextWrapping="Wrap"/></StackPanel></Grid></Border>
    <Border Style="{StaticResource Card}"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE945;" Foreground="{ThemeResource PromoTextBrush}"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="让灵感更进一步" FontWeight="SemiBold"/><TextBlock Text="借助 CalcPilot 获取结果解释和下一步建议。" Style="{StaticResource SmallLabel}" TextWrapping="Wrap"/></StackPanel></Grid></Border>
   </StackPanel>
   <StackPanel x:Name="ProfilePage" Visibility="Collapsed" Spacing="14">
    <StackPanel Spacing="6"><TextBlock Text="选择适合你的工作方式" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="个人资料可帮助你集中管理偏好与最近的计算。" TextWrapping="Wrap"/></StackPanel>
    <Border Background="{ThemeResource PromoSurfaceBrush}" BorderBrush="{ThemeResource PromoBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
     <RadioButton x:Name="PersonalProfile" GroupName="Profile" IsChecked="True" HorizontalContentAlignment="Stretch"><StackPanel Spacing="6"><TextBlock Text="使用 SuperCalc 个人资料" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="推荐 · 个性化工作空间与计算建议" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource PromoTextBrush}"/></StackPanel></RadioButton>
    </Border>
    <Border Style="{StaticResource Card}"><RadioButton GroupName="Profile"><StackPanel Spacing="6"><TextBlock Text="仅继续当前工作空间" TextWrapping="Wrap"/><TextBlock Text="稍后在设置中管理个人资料。" TextWrapping="Wrap" Style="{StaticResource SmallLabel}"/></StackPanel></RadioButton></Border>
    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="你的现有算式和历史记录将予以保留。"/>
   </StackPanel>
   <StackPanel x:Name="PreferencesPage" Visibility="Collapsed" Spacing="12">
    <StackPanel Spacing="6"><TextBlock Text="获取为你量身定制的体验" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="使用推荐设置，发现更适合你的工作方式。" TextWrapping="Wrap"/></StackPanel>
    <Border Style="{StaticResource Card}"><CheckBox x:Name="RecommendedOffers"><StackPanel Spacing="4"><TextBlock Text="个性化建议与优惠" FontWeight="SemiBold"/><TextBlock Text="在计算过程中发现相关功能和服务。" TextWrapping="Wrap" Style="{StaticResource SmallLabel}"/></StackPanel></CheckBox></Border>
    <Border Style="{StaticResource Card}"><CheckBox x:Name="EnhancedWorkflow"><StackPanel Spacing="4"><TextBlock Text="增强计算体验" FontWeight="SemiBold"/><TextBlock Text="准备结果、应用选择与后续操作建议。" TextWrapping="Wrap" Style="{StaticResource SmallLabel}"/></StackPanel></CheckBox></Border>
    <Border Style="{StaticResource Card}"><CheckBox x:Name="MotionPreference"><StackPanel Spacing="4"><TextBlock Text="动画效果" FontWeight="SemiBold"/><TextBlock Text="在页面和操作之间显示平滑过渡。" TextWrapping="Wrap" Style="{StaticResource SmallLabel}"/></StackPanel></CheckBox></Border>
   </StackPanel>
  </Grid>
  <TextBlock Text="你可以随时在“设置”中调整这些选项。" Style="{StaticResource SmallLabel}" TextWrapping="Wrap"/>
 </StackPanel>
</UserControl>
