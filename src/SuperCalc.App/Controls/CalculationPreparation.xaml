<UserControl x:Class="SuperCalc.App.Controls.CalculationPreparation" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Spacing="18" MaxWidth="520">
  <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ProgressRing x:Name="Activity" Width="40" Height="40" IsActive="True" Foreground="{ThemeResource PromoAccentBrush}"/><StackPanel Grid.Column="1" Spacing="6"><TextBlock x:Name="StageTitle" Text="正在准备你的工作空间" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="请稍候，我们正在使你的结果保持最新。" TextWrapping="Wrap" Style="{StaticResource SmallLabel}"/></StackPanel></Grid>
  <Border Background="{ThemeResource PromoSurfaceBrush}" BorderBrush="{ThemeResource PromoBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
   <StackPanel Spacing="14"><Grid><TextBlock Text="准备计算体验" FontWeight="SemiBold"/><TextBlock x:Name="Percent" Text="8%" HorizontalAlignment="Right" Foreground="{ThemeResource PromoTextBrush}"/></Grid><ProgressBar x:Name="Progress" Value="8" Foreground="{ThemeResource PromoAccentBrush}"/><StackPanel Spacing="12"><TextBlock x:Name="DeviceStep" Text="○  检查设备兼容性"/><TextBlock x:Name="SettingsStep" Text="○  应用体验设置"/><TextBlock x:Name="WorkspaceStep" Text="○  整理结果工作空间"/></StackPanel></StackPanel>
  </Border>
  <Expander Header="查看详细信息" HorizontalAlignment="Stretch"><StackPanel Spacing="8"><TextBlock x:Name="Expression" TextWrapping="Wrap"/><TextBlock Text="服务：SuperCalc 数字体验服务&#x0a;通道：当前通道&#x0a;状态：正在完成最后的准备工作" FontSize="12" TextWrapping="Wrap"/></StackPanel></Expander>
  <TextBlock Text="你可以直接查看结果，或取消本次操作。" TextWrapping="Wrap" Style="{StaticResource SmallLabel}"/>
 </StackPanel>
</UserControl>
